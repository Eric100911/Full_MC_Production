# ==============================================================================
# test_submit.sub - HTCondor submit file for pipeline tests
# ==============================================================================
# Usage:
#   condor_submit test_submit.sub
#   condor_submit test_submit.sub -append "test_mode=lhe"
#   condor_submit test_submit.sub -append "test_mode=shower" -append "shower_mode=sps"
# ==============================================================================

universe = vanilla
executable = /bin/bash
initialdir = /tmp
# base_dir is injected by tests/submit_test.sh (sources common/paths.sh).
base_dir = <SET_BY_WRAPPER>
log_root = $(base_dir)/tests/log

# Arguments: test_mode pool_type shower_mode random_seed num_events
arguments = test_pipeline.sh $(test_mode) $(pool_type) $(shower_mode) $(Process) $(num_events)

# Default values
test_mode = full
pool_type = pool_jpsi_upsilon_CSCO
shower_mode = normal
num_events = 10

# Input files
transfer_input_files = $(base_dir)/tests/test_pipeline.sh, \
                       $(base_dir)/lhe_generation/run_helac.sh, \
                       $(base_dir)/common/packages/helac_package.tar.gz, \
                       $(base_dir)/lhe_generation/lhe_pythia6_pythia8.f, \
                       $(base_dir)/processing/pythia_shower/shower_normal, \
                       $(base_dir)/processing/pythia_shower/shower_phi, \
                       $(base_dir)/processing/pythia_shower/shower_sps, \
                       $(base_dir)/processing/pythia_shower/event_mixer_multisource

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

# Avoid requiring AFS on execute nodes
getenv = False
environment = HOME=/tmp

# Override AFS usage flags
+UseAFSHome = False
+UseAFSWork = False
+WantAFS = False

# Prefer CVMFS-capable nodes
+WantCVMFS = True

# Override local requirements to avoid AFS-only constraint
+PreLocalRequirements = True
+PreAfsRequirements = True

# Output/Error/Log
output = $(log_root)/test_$(Cluster)_$(Process).out
error  = $(log_root)/test_$(Cluster)_$(Process).err
log    = $(log_root)/test_$(Cluster).log

# Requirements
Requirements = (OpSysAndVer == "AlmaLinux8" || OpSysAndVer == "CentOS8" || OpSysAndVer == "Rocky8" || OpSysAndVer == "AlmaLinux9" || OpSysAndVer == "Rocky9")
+JobFlavour = "longlunch"

# Request resources
request_cpus = 1
request_memory = 4GB
request_disk = 10GB

# Queue 1 job
queue 1
