# ==============================================================================
# lhe_gen_test.sub - 旧测试入口兼容模板
# ==============================================================================
# Variables:
#   lhe_bundle_path / lhe_bundle_name / proxy_bundle_path / proxy_bundle_name
#   pool / seed / min_pt_* / log_root
# ==============================================================================
# 说明：
# 1. 保留给历史脚本兼容使用。
# 2. 启动方式与正式模板一致：runtime bundle + proxy bundle。
# 3. 资源请求固定为小批量 fast-test 档位。
# ==============================================================================

Universe = vanilla

Executable = /bin/bash
transfer_executable = False
Arguments = "-lc 'set -euo pipefail; tar -xzf $(proxy_bundle_name); chmod 600 credentials/x509_user_proxy; export X509_USER_PROXY=\"$PWD/credentials/x509_user_proxy\"; tar -xzf $(lhe_bundle_name); cd runtime/lhe_generation; bash run_helac.sh --pool $(pool) --seed $(seed) --min-pt-conia $(min_pt_conia) --min-pt-bonia $(min_pt_bonia) --min-pt-q $(min_pt_q) --unwevt 50 --test-mode true'"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT
Transfer_Input_Files = $(lhe_bundle_path), $(proxy_bundle_path)
transfer_output_files =

Output = $(log_root)/lhe_$(pool)_$(seed)_$(Cluster)_$(Process).stdout
Error = $(log_root)/lhe_$(pool)_$(seed)_$(Cluster)_$(Process).stderr
Log = $(log_root)/lhe_$(pool)_$(seed)_$(Cluster).log

request_cpus = 4
request_memory = 8GB
request_disk = 8GB

+MaxRuntime = 86400
Environment = "HOME=/srv"

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "LHE test job failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
