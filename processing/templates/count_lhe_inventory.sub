# Plain HTCondor cluster for one-file-per-process LHE event counting.
universe = vanilla
initialdir = $(work_dir)

executable = /usr/bin/python3
arguments = "$(worker_name) worker $(worklist_name) $(Process) $(proxy_name) count_result.json"

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = $(worker_path),$(worklist_path)$(proxy_transfer_suffix)
transfer_output_files = count_result.json
transfer_output_remaps = "count_result.json=results/count_$(Process).json"

output = logs/count_$(Cluster)_$(Process).stdout
error = logs/count_$(Cluster)_$(Process).stderr
log = logs/count_$(Cluster).log

request_cpus = 1
request_memory = 2GB
request_disk = 10GB
requirements = $(count_requirements)

+MaxRuntime = 86400
max_materialize = $(max_materialize_count)

on_exit_hold = (ExitCode != 0)
on_exit_hold_reason = "LHE event counting failed"

queue $(task_count)
