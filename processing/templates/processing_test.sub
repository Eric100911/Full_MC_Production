# ==============================================================================
# processing_test.sub - 旧测试入口兼容模板
# ==============================================================================
# Variables:
#   processing_bundle_path / processing_bundle_name / proxy_bundle_path / proxy_bundle_name
#   inputs / modes / analysis / campaign / job_id / log_root
# ==============================================================================
# 说明：
# 1. 保留给历史脚本兼容使用。
# 2. 启动方式与正式模板一致：runtime bundle + proxy bundle。
# 3. 默认只跑到小批量 processing 验证，资源请求固定为测试档位。
# ==============================================================================

Universe = vanilla

Executable = /bin/bash
transfer_executable = False
Arguments = "-lc 'set -euo pipefail; tar -xzf $(proxy_bundle_name); chmod 600 credentials/x509_user_proxy; export X509_USER_PROXY=\"$PWD/credentials/x509_user_proxy\"; tar -xzf $(processing_bundle_name); cd runtime/processing; bash run_chain.sh --inputs $(inputs) --modes $(modes) --analysis $(analysis) --campaign $(campaign) --job-id $(job_id) --max-events 100 --enable-ntuple false --cleanup true'"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT
Transfer_Input_Files = $(processing_bundle_path), $(proxy_bundle_path)
transfer_output_files =

Output = $(log_root)/proc_test_$(campaign)_$(job_id)_$(Cluster)_$(Process).stdout
Error = $(log_root)/proc_test_$(campaign)_$(job_id)_$(Cluster)_$(Process).stderr
Log = $(log_root)/proc_test_$(campaign)_$(job_id)_$(Cluster).log

request_cpus = 4
request_memory = 12GB
request_disk = 20GB

+MaxRuntime = 86400
Environment = "HOME=/srv"

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el8:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "Processing test job failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
