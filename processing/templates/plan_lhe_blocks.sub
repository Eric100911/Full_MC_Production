# ==============================================================================
# plan_lhe_blocks.sub - LHE block planner node
#
# Runs after a HELAC LHE generation job. Locates the LHE output,
# shuffle-splits into blocks, compresses, and writes a plan manifest.
# ==============================================================================

Universe = vanilla

Executable = $(plan_wrapper_path)
transfer_executable = True
Arguments = "$(proxy_bundle_name) $(plan_bundle_name) $(config_name)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT
Transfer_Input_Files = $(plan_bundle_path), $(proxy_bundle_path), $(config_path)

transfer_output_files =

Output = $(log_root)/plan_$(pool)_$(group_id)_$(Cluster)_$(Process).stdout
Error  = $(log_root)/plan_$(pool)_$(group_id)_$(Cluster)_$(Process).stderr
Log    = $(log_root)/plan_$(pool)_$(group_id)_$(Cluster).log

request_cpus   = 1
request_memory = 2GB
request_disk   = 5GB

+MaxRuntime = 86400

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "LHE block planning failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
