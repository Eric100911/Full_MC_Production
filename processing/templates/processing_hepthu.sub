# ==============================================================================
# processing_hepthu.sub - shower/mix/CMSSW submit template for hepthu HTCondor
# ==============================================================================

Universe = vanilla

Executable = $(processing_wrapper_path)
transfer_executable = True
arguments = "$(proxy_bundle_name) $(processing_bundle_name) $(config_name)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(processing_bundle_path), $(proxy_bundle_path), $(config_path)

transfer_output_files =

Output = proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).stdout
Error  = proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).stderr
Log    = proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

requirements = (TARGET.Machine == "$(target_machine)")
getenv = True
initialdir = $(log_root)

environment = ""

+MaxRuntime = 604800

# CMSSW_12 compatibility is handled explicitly inside run_chain.sh.
OnExitHold = (ExitCode != 0)
OnExitHoldReason = "Processing chain failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
