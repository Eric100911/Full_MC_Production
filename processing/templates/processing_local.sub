# ==============================================================================
# processing_local.sub - shower/mix/CMSSW submit template for local HTCondor.
#
# Template variables:
#   proxy_bundle_name, proxy_bundle_path
#   processing_bundle_name, processing_bundle_path
#   request_cpus, request_memory, request_disk
#   log_root
#   Cluster, Process (HTCondor built-ins)
# ==============================================================================

Universe = vanilla

Executable = $(processing_wrapper_path)
transfer_executable = True
arguments = "$(proxy_bundle_name) $(processing_bundle_name) $(config_name)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(processing_bundle_path), $(proxy_bundle_path), $(config_path)

transfer_output_files =

Output = $(log_root)/proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).stdout
Error  = $(log_root)/proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).stderr
Log    = $(log_root)/proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

+MaxRuntime = 604800

Environment = "HOME=/srv"

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el8:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "Processing chain failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
