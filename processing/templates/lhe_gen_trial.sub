# ==============================================================================
# lhe_gen_trial.sub - isolated HELAC LHE trial
# ==============================================================================
# The trial driver supplies all variables below with condor_submit -append.
# It intentionally uses the normal production wrapper, not the fast-test entry.
# The driver supplies job_flavour: tomorrow for normal points and testmatch for
# the large stress point.
# ==============================================================================

Universe = vanilla

Executable = $(lhe_wrapper_path)
transfer_executable = True
arguments = "$(proxy_bundle_name) $(lhe_bundle_name) $(config_name)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT_OR_EVICT

Transfer_Input_Files = $(lhe_bundle_path), $(proxy_bundle_path), $(config_path)

transfer_output_files = wrapper_logs
transfer_output_remaps = "wrapper_logs/wrapper.stdout=$(log_root)/lhe_$(pool)_$(min_pt_q_label)_$(Cluster)_$(Process).wrapper.stdout;wrapper_logs/wrapper.stderr=$(log_root)/lhe_$(pool)_$(min_pt_q_label)_$(Cluster)_$(Process).wrapper.stderr"

Output = $(log_root)/lhe_$(pool)_$(min_pt_q_label)_$(Cluster)_$(Process).stdout
Error  = $(log_root)/lhe_$(pool)_$(min_pt_q_label)_$(Cluster)_$(Process).stderr
Log    = $(log_root)/lhe_$(pool)_$(min_pt_q_label)_$(Cluster).log

request_cpus = 8
request_memory = 15GB
request_disk = 10GB

+JobFlavour = "$(job_flavour)"

Environment = "HOME=/srv"

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "HELAC LHE trial failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
