# ==============================================================================
# processing.sub - shower/mix/CMSSW 处理节点 submit 模板
# ==============================================================================
# 由 dag_generator.py 通过 DAGMan VARS 注入以下变量：
#   campaign / job_id / inputs / modes / analysis / n_sources
#   max_events / enable_ntuple / efficiency_ntuple / cleanup
#   request_cpus / request_memory / request_disk
#   processing_bundle_path / processing_bundle_name / proxy_bundle_path / proxy_bundle_name
#   log_root
# ==============================================================================

Universe = vanilla

Executable = $(processing_wrapper_path)
transfer_executable = True
arguments = "$(proxy_bundle_name) $(processing_bundle_name) $(inputs) $(modes) $(analysis) $(campaign) $(job_id) $(max_events) $(enable_ntuple) $(efficiency_ntuple) $(cleanup) $(local_output_base) $(shuffle_mixing) $(target_eos_base)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(processing_bundle_path), $(proxy_bundle_path)

transfer_output_files =

Output = $(log_root)/proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).stdout
Error  = $(log_root)/proc_$(campaign)_$(job_id)_$(Cluster)_$(Process).stderr
Log    = $(log_root)/proc_$(campaign)_$(job_id)_$(Cluster).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

+MaxRuntime = 604800

Environment = "HOME=/srv"

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el9:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "Processing chain failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
