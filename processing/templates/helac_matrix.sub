# ==============================================================================
# helac_matrix.sub - HELAC-only J/psi+Upsilon Fock-state matrix submit template
# ==============================================================================
# Variables:
#   charm_state / bottom_state / extra_gluon / job_slug / seed / stageout_dir
#   min_pt_* / unwevt / test_mode
#   request_cpus / request_memory / request_disk
#   lhe_bundle_path / lhe_bundle_name / proxy_bundle_path / proxy_bundle_name
#   log_root
# ==============================================================================

Universe = vanilla

Executable = /bin/bash
transfer_executable = False
Arguments = "-lc 'set -euo pipefail; tar -xzf $(proxy_bundle_name); chmod 600 credentials/x509_user_proxy; export X509_USER_PROXY=\"$PWD/credentials/x509_user_proxy\"; tar -xzf $(lhe_bundle_name); cd runtime/lhe_generation; bash run_helac.sh --pool helac_matrix --charm-state $(charm_state) --bottom-state $(bottom_state) --extra-gluon $(extra_gluon) --job-slug $(job_slug) --stageout-mode helac-output --seed $(seed) --output-dir $(stageout_dir) --min-pt-conia $(min_pt_conia) --min-pt-bonia $(min_pt_bonia) --min-pt-q $(min_pt_q) --unwevt $(unwevt) --test-mode $(test_mode)'"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(lhe_bundle_path), $(proxy_bundle_path)
transfer_output_files =

Output = $(log_root)/helac_matrix_$(job_slug)_$(seed)_$(Cluster)_$(Process).stdout
Error  = $(log_root)/helac_matrix_$(job_slug)_$(seed)_$(Cluster)_$(Process).stderr
Log    = $(log_root)/helac_matrix_$(Cluster).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

+MaxRuntime = 604800

Environment = "HOME=/srv"

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "HELAC matrix generation failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
