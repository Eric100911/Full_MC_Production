# ==============================================================================
# lhe_gen_hepthu.sub - LHE generation submit template for hepthu HTCondor
# ==============================================================================

Universe = vanilla

Executable = $(lhe_wrapper_path)
transfer_executable = True
arguments = "$(proxy_bundle_name) $(lhe_bundle_name) $(config_name)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(lhe_bundle_path), $(proxy_bundle_path), $(config_path)

transfer_output_files =

Output = lhe_$(pool)_$(seed)_$(Cluster)_$(Process).stdout
Error  = lhe_$(pool)_$(seed)_$(Cluster)_$(Process).stderr
Log    = lhe_$(pool)_$(seed)_$(Cluster)_$(Process).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

requirements = (TARGET.Machine == "$(target_machine)")
getenv = True
initialdir = $(log_dir)

environment = "LOCAL_OUTPUT_BASE=$(local_output_base)"

+MaxRuntime = 604800

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "LHE generation failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
