# ==============================================================================
# lhe_gen_local.sub - LHE generation submit template for local HTCondor.
#
# Template variables:
#   proxy_bundle_name, proxy_bundle_path
#   lhe_bundle_name, lhe_bundle_path
#   pool, seed, min_pt_conia, min_pt_bonia, min_pt_q, unwevt, test_mode
#   request_cpus, request_memory, request_disk
#   log_dir, LOCAL_LOG_DIR
#   local_output_base
#   Cluster, Process (HTCondor built-ins)
# ==============================================================================

LOCAL_LOG_DIR = $(log_dir)

Universe = vanilla

Executable = $(lhe_wrapper_path)
transfer_executable = True
arguments = "$(proxy_bundle_name) $(lhe_bundle_name) $(pool) $(seed) $(min_pt_conia) $(min_pt_bonia) $(min_pt_q) $(unwevt) $(test_mode) $(local_output_base) $(compress_lhe) $(lhe_compression_level)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT

Transfer_Input_Files = $(lhe_bundle_path), $(proxy_bundle_path)

transfer_output_files =

Output = $(LOCAL_LOG_DIR)/lhe_$(pool)_$(seed)_$(Cluster)_$(Process).stdout
Error  = $(LOCAL_LOG_DIR)/lhe_$(pool)_$(seed)_$(Cluster)_$(Process).stderr
Log    = $(LOCAL_LOG_DIR)/lhe_$(pool)_$(seed)_$(Cluster)_$(Process).log

request_cpus = $(request_cpus)
request_memory = $(request_memory)
request_disk = $(request_disk)

+MaxRuntime = 604800

Environment = "HOME=/srv LOCAL_OUTPUT_BASE=$(local_output_base)"

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el7:x86_64"

OnExitHold = (ExitCode != 0)
OnExitHoldReason = "LHE generation failed"
OnExitHoldSubCode = 1
PeriodicRelease = (JobRunCount < 2) && (HoldReasonCode == 3)

Queue 1
