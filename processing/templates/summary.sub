# ==============================================================================
# summary.sub - DAG 汇总节点
# ==============================================================================

Universe = vanilla

Executable = /bin/bash
transfer_executable = False
# ``subdag_root`` was added after existing production DAGs were submitted.
# Its empty default preserves their eight-argument summary_final.sh interface.
Arguments = "$(summary_script_name) $(summary_bundle_name) $(proxy_bundle_name) $(log_source_root) $(subdag_root:) $(target_base_url) $(workflow_archive_id) $(archive_enabled) $(DAG_STATUS) $(FAILED_COUNT)"

Should_Transfer_Files = YES
WhenToTransferOutput = ON_EXIT_OR_EVICT
Transfer_Input_Files = $(summary_script_path), $(summary_bundle_path), $(proxy_bundle_path)

transfer_output_files = wrapper_logs
transfer_output_remaps = "wrapper_logs/wrapper.stdout=$(log_root)/summary_$(Cluster)_$(Process).wrapper.stdout;wrapper_logs/wrapper.stderr=$(log_root)/summary_$(Cluster)_$(Process).wrapper.stderr"

Output = $(log_root)/summary_$(Cluster)_$(Process).stdout
Error  = $(log_root)/summary_$(Cluster)_$(Process).stderr
Log    = $(log_root)/summary_$(Cluster).log

request_cpus = 1
request_memory = 2GB
request_disk = 10GB

+MaxRuntime = 21600
+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/cmssw/el9:x86_64"

# ``log_level`` is delivered through the environment rather than argv so the
# positional summary_final.sh argument contract stays fixed; an empty default
# means info for DAGs generated before the variable existed.
Environment = "HOME=/srv WORKFLOW_LOG_LEVEL=$(log_level:)"

Queue 1
